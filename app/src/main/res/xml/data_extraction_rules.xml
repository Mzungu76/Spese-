<?xml version="1.0" encoding="utf-8"?>
<!-- I dati finanziari non vengono mai inclusi nei backup cloud di Android: il backup è sotto il controllo dell'utente. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" path="." /><exclude domain="database" path="." /><exclude domain="file" path="." /><exclude domain="sharedpref" path="." /></cloud-backup>
    <device-transfer><exclude domain="root" path="." /></device-transfer>
</data-extraction-rules>
